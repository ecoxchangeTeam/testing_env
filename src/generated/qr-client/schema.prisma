generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/qr-client"
}

datasource db {
  provider = "postgresql"
}

model ActivationRecord {
  id          String   @id @default(cuid())
  dppId       String
  productId   String
  status      String
  activatedAt DateTime @default(now())
  ipAddress   String?
  deviceInfo  String?
  activatedBy String?
  qrRecordId  String?
}

model ProductSnapshot {
  id             String   @id @default(cuid())
  dppId          String   @unique
  productId      String
  productName    String
  category       String
  brand          String?
  model          String?
  serialNumber   String?
  status         String
  createdAt      DateTime @default(now())
  conditionScore Int?
  owner          String?
  trustScore     Int?
  updatedAt      DateTime @updatedAt
}

model QRRecord {
  id            String    @id @default(cuid())
  dppId         String    @unique
  productId     String
  activationUrl String
  status        String
  scanCount     Int       @default(0)
  generatedAt   DateTime  @default(now())
  lastScannedAt DateTime?
  qrHash        String
  generatedBy   String?
}

model QRInventory {
  id        String   @id @default(cuid())
  dppId     String   @unique
  status    String
  category  String?
  name      String?
  brand     String?
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("qr_inventory")
}
